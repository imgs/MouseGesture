{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "26.7.13.10",
  "description": "__MSG_extDesc__",
  "default_locale": "en_US",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "sessions",
    "clipboardWrite",
    "scripting",
    "downloads",
    "windows",
    "system.display",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ext-console.js",
        "settings-common.js",
        "screenshot.js",
        "preview.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ext-console.js",
        "settings-common.js",
        "unlock-restrictions-bridge.js",
        "ui-shadow-host.js",
        "scroll-gesture.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "screenshot-pins.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
